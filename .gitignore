# --- Ambiente de desenvolvimento local -----------------------------------
# MariaDB portátil, dados da base, php.ini de desenvolvimento e registos.
# Nada disto faz parte da aplicação: são centenas de MB de binários.
.localdb/

# --- Ferramentas do editor/agente ---------------------------------------
.agents/
.impeccable/
.cloud-attachments/

# --- Dados carregados pelos utilizadores --------------------------------
# As fotografias de equipamento são dados de clientes: não vão para o
# repositório. A pasta fica, vazia, porque a aplicação precisa dela.
uploads/*
!uploads/.gitkeep
# A única excepção é a fotografia de demonstração, referida em
# sql/dados-demonstracao.sql: sem ela, a galeria da ficha nasce vazia numa
# instalação nova. O Git não entra numa pasta excluída, por isso cada nível
# do caminho tem de ser reaberto até chegar ao ficheiro.
!uploads/pedidos/
uploads/pedidos/*
!uploads/pedidos/6/
uploads/pedidos/6/*
!uploads/pedidos/6/estado-entrada-1.png

# --- Lixo de sistema e de editores ---------------------------------------
*.log
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
